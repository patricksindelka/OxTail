{
    "version": "@VERSION@",
    "description": "Fast, portable, real-time log viewer (a modern successor to BareTail)",
    "homepage": "https://github.com/patricksindelka/OxTail",
    "license": "MIT OR Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/patricksindelka/OxTail/releases/download/v@VERSION@/oxtail-@VERSION@-x86_64-windows.zip",
            "hash": "@SHA256_WINDOWS_ZIP@"
        }
    },
    "bin": "oxtail.exe",
    "shortcuts": [
        [
            "oxtail.exe",
            "OxTail"
        ]
    ],
    "persist": "oxtail-data",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/patricksindelka/OxTail/releases/download/v$version/oxtail-$version-x86_64-windows.zip",
                "hash": {
                    "url": "$baseurl/SHA256SUMS",
                    "regex": "$sha256\\s+$basename"
                }
            }
        }
    }
}
